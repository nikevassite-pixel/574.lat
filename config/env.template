# n8n Automation Workflows - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials
# NEVER commit the .env file to version control!

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL Database Connection
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=n8n_workflows
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_password_here

# Database Connection Pool
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ============================================================================
# OPENAI API
# ============================================================================

# OpenAI API Key (for GPT-4, DALL-E, embeddings)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_ORG_ID=org-xxxxxxxxxxxxxxxx

# Model configurations
OPENAI_MODEL_GPT=gpt-4-turbo-preview
OPENAI_MODEL_DALLE=dall-e-3
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# ============================================================================
# SOCIAL MEDIA APIs
# ============================================================================

# Twitter / X API (OAuth 2.0)
# Get from: https://developer.twitter.com/
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# Facebook / Instagram Graph API
# Get from: https://developers.facebook.com/
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_ACCESS_TOKEN=your_long_lived_access_token

# ============================================================================
# GOOGLE SERVICES
# ============================================================================

# Google Sheets API (OAuth 2.0)
# Get from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Gmail API (OAuth 2.0)
GMAIL_CLIENT_ID=your_gmail_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_gmail_client_secret

# ============================================================================
# E-COMMERCE PLATFORMS
# ============================================================================

# Shopify
# Get from: Shopify Admin > Apps > Develop apps
SHOPIFY_SHOP_NAME=your-shop-name
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-01

# WooCommerce
# Get from: WordPress Admin > WooCommerce > Settings > Advanced > REST API
WOOCOMMERCE_URL=https://your-store.com
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# CUSTOMER SUPPORT
# ============================================================================

# Zendesk
# Get from: Admin Center > Apps and integrations > APIs > Zendesk API
ZENDESK_SUBDOMAIN=your-company
ZENDESK_EMAIL=admin@your-company.com
ZENDESK_API_TOKEN=your_zendesk_api_token

# ============================================================================
# COMMUNICATION PLATFORMS
# ============================================================================

# Slack
# Get from: https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_SIGNING_SECRET=your_slack_signing_secret

# Telegram Bot
# Get from: @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Microsoft Teams (optional)
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR/WEBHOOK/URL

# ============================================================================
# FINANCIAL DATA APIs
# ============================================================================

# Alpha Vantage (Stock Market Data)
# Get from: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your_alpha_vantage_api_key

# Yahoo Finance (no key required, but rate limited)
YAHOO_FINANCE_ENABLED=true

# CoinGecko API (free tier, no key required for basic)
COINGECKO_API_KEY=your_coingecko_api_key_if_pro

# ============================================================================
# WEATHER & NEWS APIs
# ============================================================================

# OpenWeatherMap
# Get from: https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_api_key

# News API (optional)
# Get from: https://newsapi.org/
NEWS_API_KEY=your_news_api_key

# ============================================================================
# IOT & MONITORING
# ============================================================================

# MQTT Broker
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=admin
MQTT_PASSWORD=your_mqtt_password
MQTT_CLIENT_ID=n8n-iot-client

# InfluxDB (Time Series Database)
# Get from your InfluxDB instance
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your_influxdb_token_here
INFLUXDB_ORG=your-organization
INFLUXDB_BUCKET=iot-sensors

# PagerDuty
# Get from: https://support.pagerduty.com/docs/api-access-keys
PAGERDUTY_API_KEY=your_pagerduty_api_key
PAGERDUTY_SERVICE_ID=your_service_id
PAGERDUTY_FROM_EMAIL=alerts@your-company.com

# ============================================================================
# PROJECT MANAGEMENT
# ============================================================================

# Trello
# Get from: https://trello.com/app-key
TRELLO_API_KEY=your_trello_api_key
TRELLO_API_TOKEN=your_trello_token
TRELLO_BOARD_ID=your_board_id

# Asana
# Get from: https://app.asana.com/0/developer-console
ASANA_ACCESS_TOKEN=your_asana_personal_access_token
ASANA_WORKSPACE_ID=your_workspace_id
ASANA_PROJECT_ID=your_project_id

# Jira Cloud
# Get from: Atlassian Account Settings > Security > API tokens
JIRA_DOMAIN=your-company.atlassian.net
JIRA_EMAIL=your-email@your-company.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=YOUR_PROJECT

# ============================================================================
# CONTENT MANAGEMENT
# ============================================================================

# WordPress
# Get from: WordPress Admin > Users > Profile > Application Passwords
WORDPRESS_URL=https://your-blog.com
WORDPRESS_USERNAME=your_username
WORDPRESS_APP_PASSWORD=your_application_password

# Medium
# Get from: https://medium.com/me/settings (Integration tokens)
MEDIUM_ACCESS_TOKEN=your_medium_integration_token
MEDIUM_USER_ID=your_medium_user_id

# ============================================================================
# AI & NLP SERVICES
# ============================================================================

# Hugging Face
# Get from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Dialogflow (optional)
DIALOGFLOW_PROJECT_ID=your-project-id
DIALOGFLOW_CREDENTIALS=path/to/service-account.json

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================

# SMTP for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your_app_password

# Email settings
EMAIL_FROM=noreply@your-company.com
EMAIL_FROM_NAME=n8n Automation
EMAIL_REPLY_TO=support@your-company.com

# ============================================================================
# N8N CONFIGURATION
# ============================================================================

# n8n Instance
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=your_n8n_password

# n8n Database (if using PostgreSQL for n8n itself)
N8N_DATABASE_TYPE=postgresdb
N8N_DATABASE_POSTGRES_HOST=localhost
N8N_DATABASE_POSTGRES_PORT=5432
N8N_DATABASE_POSTGRES_DATABASE=n8n
N8N_DATABASE_POSTGRES_USER=n8n
N8N_DATABASE_POSTGRES_PASSWORD=n8n_password

# Execution settings
N8N_EXECUTION_TIMEOUT=300
N8N_EXECUTION_TIMEOUT_MAX=3600
N8N_PAYLOAD_SIZE_MAX=16

# ============================================================================
# SECURITY & ENCRYPTION
# ============================================================================

# Encryption key for sensitive data
ENCRYPTION_KEY=your_32_character_encryption_key

# JWT secret for authentication
JWT_SECRET=your_jwt_secret_key_here

# CORS settings
CORS_ENABLED=true
CORS_ORIGIN=*

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

# Log level: error, warn, info, verbose, debug
LOG_LEVEL=info
LOG_OUTPUT=console,file
LOG_FILE_PATH=/var/log/n8n/workflows.log

# Sentry for error tracking (optional)
SENTRY_DSN=your_sentry_dsn_here

# ============================================================================
# PERFORMANCE & SCALING
# ============================================================================

# Queue mode (for distributed execution)
QUEUE_MODE=memory
# For Redis queue:
# QUEUE_MODE=redis
# QUEUE_REDIS_HOST=localhost
# QUEUE_REDIS_PORT=6379
# QUEUE_REDIS_PASSWORD=your_redis_password

# Worker settings
EXECUTIONS_PROCESS=main
# For separate workers:
# EXECUTIONS_PROCESS=worker

# Concurrency
WORKFLOW_CONCURRENCY=10

# ============================================================================
# BACKUP & RETENTION
# ============================================================================

# Data retention periods (days)
LOG_RETENTION_DAYS=90
EXECUTION_RETENTION_DAYS=30
CHATBOT_RETENTION_DAYS=90
SUPPORT_TICKET_RETENTION_DAYS=180

# Backup settings
BACKUP_ENABLED=true
BACKUP_PATH=/backups
BACKUP_SCHEDULE=0 2 * * *

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable/disable specific workflows
WORKFLOW_SOCIAL_MEDIA_ENABLED=true
WORKFLOW_CONTENT_GEN_ENABLED=true
WORKFLOW_INVENTORY_SYNC_ENABLED=true
WORKFLOW_SUPPORT_ROUTING_ENABLED=true
WORKFLOW_FINANCIAL_DATA_ENABLED=true
WORKFLOW_IOT_MONITORING_ENABLED=true
WORKFLOW_TASK_SYNC_ENABLED=true
WORKFLOW_CHATBOT_ENABLED=true

# Feature-specific flags
ENABLE_AI_FEATURES=true
ENABLE_NOTIFICATIONS=true
ENABLE_AUTO_RESPONSES=true
ENABLE_ESCALATIONS=true

# ============================================================================
# DEVELOPMENT & TESTING
# ============================================================================

# Environment
NODE_ENV=production
# Options: development, staging, production

# Debug mode
DEBUG_MODE=false

# Test mode (prevents actual API calls)
TEST_MODE=false
USE_MOCK_DATA=false

# ============================================================================
# RATE LIMITING
# ============================================================================

# API rate limits (requests per minute)
RATE_LIMIT_OPENAI=50
RATE_LIMIT_TWITTER=100
RATE_LIMIT_FACEBOOK=200
RATE_LIMIT_SHOPIFY=40

# Retry configuration
MAX_RETRY_ATTEMPTS=3
RETRY_BACKOFF_MS=2000

# ============================================================================
# CUSTOM INTEGRATIONS
# ============================================================================

# Add your custom API keys and configurations here
# CUSTOM_API_KEY=your_custom_api_key
# CUSTOM_ENDPOINT=https://api.custom-service.com

# ============================================================================
# NOTES
# ============================================================================

# 1. Replace all placeholder values with your actual credentials
# 2. Keep this file secure and never commit to version control
# 3. Add .env to your .gitignore file
# 4. Use different values for development/staging/production
# 5. Rotate API keys and secrets regularly
# 6. Use environment-specific encryption keys
# 7. Enable HTTPS in production (N8N_PROTOCOL=https)
# 8. Set strong passwords for all services
# 9. Limit API key permissions to minimum required
# 10. Monitor API usage and costs regularly

# For more information, see: docs/SETUP.md
