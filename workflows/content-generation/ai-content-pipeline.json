        "value1": "={{ { feedUrl: 'https://techcrunch.com/feed/', wordpressUrl: 'https://yourblog.com', mediumUserId: 'your-medium-user-id', mediumToken: 'your-medium-token' } }}"
      },
      "id": "set-config",
      "name": "Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [250, 300]
    }
