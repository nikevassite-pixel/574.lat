        },
        "options": {}
      },
      "id": "save-to-database",
      "name": "Save to Database",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [2250, 300],
      "credentials": {
        "postgres": {
          "id": "7",
          "name": "PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "content": "## AI-Powered Content Generation Pipeline\\n\\nThis workflow:\\n1. Fetches RSS feeds\\n2. Filters recent articles\\n3. Uses OpenAI GPT-4 to rewrite content\\n4. Generates featured images with DALL-E\\n5. Publishes to WordPress and Medium as drafts\\n6. Logs to database\\n\\n**Setup:**\\n- Configure OpenAI API credentials\\n- Set up WordPress REST API\\n- Configure Medium API token\\n- Create PostgreSQL database table",
        "height": 450,
        "width": 350
      },
      "id": "sticky-note",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [240, 480]
    },
