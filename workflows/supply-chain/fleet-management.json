{"name":"Fleet Management & GPS Tracking Logistics","nodes":[{"parameters":{"rule":{"interval":[{"field":"minutes","minutesInterval":15}]}},"id":"schedule","name":"Schedule - Track Vehicles","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1,"position":[250,300]},{"parameters":{"url":"=https://api.geotab.com/v1/Get/Device?credentials={{ $env.GEOTAB_CREDENTIALS }}"},"id":"fetch-gps","name":"Geotab API - Fetch Vehicle Locations","type":"n8n-nodes-base.httpRequest","typeVersion":4.1,"position":[450,300]},{"parameters":{"functionCode":"const vehicles = $input.all();\nconst alerts = [];\nvehicles.forEach(v => {\n  const speed = v.json.speed || 0;\n  const idleTime = v.json.idleTime || 0;\n  if (speed > 80) alerts.push({vehicle: v.json.name, alert: 'Speeding', value: speed});\n  if (idleTime > 30) alerts.push({vehicle: v.json.name, alert: 'Excessive Idle', value: idleTime});\n});\nreturn alerts.map(a => ({json: a}));"},"id":"check-violations","name":"Check for Violations","type":"n8n-nodes-base.code","typeVersion":2,"position":[650,300]},{"parameters":{"resource":"channel","operation":"sendMessage","channelId":"={{ $env.SLACK_FLEET_CHANNEL }}","text":"=🚨 Fleet Alert: Vehicle {{ $json.vehicle }} - {{ $json.alert }} ({{ $json.value }})"},"id":"notify","name":"Slack - Send Fleet Alert","type":"n8n-nodes-base.slack","typeVersion":2.1,"position":[850,300],"credentials":{"slackApi":{"id":"10","name":"Slack API"}}}],"connections":{"Schedule - Track Vehicles":{"main":[[{"node":"Geotab API - Fetch Vehicle Locations","type":"main","index":0}]]},"Geotab API - Fetch Vehicle Locations":{"main":[[{"node":"Check for Violations","type":"main","index":0}]]},"Check for Violations":{"main":[[{"node":"Slack - Send Fleet Alert","type":"main","index":0}]]}},"settings":{"executionOrder":"v1"},"tags":[{"id":"fleet","name":"Fleet Management"}],"versionId":"1.0.0"}
