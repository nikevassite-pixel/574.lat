{"name":"Manufacturing Quality Control & Defect Detection","nodes":[{"parameters":{"rule":{"interval":[{"field":"minutes","minutesInterval":30}]}},"id":"schedule","name":"Schedule - QC Check","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1,"position":[250,300]},{"parameters":{"operation":"executeQuery","query":"SELECT batch_id, product_id, defect_count, inspection_time FROM quality_inspections WHERE inspection_time >= NOW() - INTERVAL '30 minutes'"},"id":"fetch-inspections","name":"PostgreSQL - Fetch Recent Inspections","type":"n8n-nodes-base.postgres","typeVersion":2.2,"position":[450,300],"credentials":{"postgres":{"id":"4","name":"PostgreSQL"}}},{"parameters":{"functionCode":"const inspections = $input.all();\nconst defectThreshold = 5;\nconst failedBatches = inspections.filter(i => i.json.defect_count > defectThreshold);\nreturn failedBatches.length > 0 ? failedBatches : [{json: {message: 'All batches passed QC'}}];"},"id":"check-defects","name":"Check Defect Threshold","type":"n8n-nodes-base.code","typeVersion":2,"position":[650,300]},{"parameters":{"resource":"channel","operation":"sendMessage","channelId":"={{ $env.SLACK_QC_CHANNEL }}","text":"=⚠️ QC Alert: Batch {{ $json.batch_id }} has {{ $json.defect_count }} defects (threshold: 5). Product: {{ $json.product_id }}"},"id":"alert","name":"Slack - Quality Control Alert","type":"n8n-nodes-base.slack","typeVersion":2.1,"position":[850,300],"credentials":{"slackApi":{"id":"10","name":"Slack API"}}}],"connections":{"Schedule - QC Check":{"main":[[{"node":"PostgreSQL - Fetch Recent Inspections","type":"main","index":0}]]},"PostgreSQL - Fetch Recent Inspections":{"main":[[{"node":"Check Defect Threshold","type":"main","index":0}]]},"Check Defect Threshold":{"main":[[{"node":"Slack - Quality Control Alert","type":"main","index":0}]]}},"settings":{"executionOrder":"v1"},"tags":[{"id":"manufacturing","name":"Manufacturing"}],"versionId":"1.0.0"}
