    {
      "parameters": {
        "jsCode": "// Route sync action to appropriate platform\nconst syncAction = $input.first().json;\nconst task = syncAction.task;\n\nconst routedActions = [];\n\nsyncAction.targets.forEach(target => {\n  routedActions.push({\n    target: target,\n    action: syncAction.action,\n    task: task\n  });\n});\n\nreturn routedActions.map(action => ({ json: action }));"
      },
