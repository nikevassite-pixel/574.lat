    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO task_sync_state (external_id, source, title, description, status, due_date, sync_hash, last_modified, synced_at)\\nVALUES ('{{ $json.external_id }}', '{{ $json.source }}', '{{ $json.title }}', '{{ $json.description }}', '{{ $json.status }}', '{{ $json.due_date }}', '{{ $json.sync_hash }}', '{{ $json.last_modified }}', NOW())\\nON CONFLICT (external_id, source) DO UPDATE\\nSET title = EXCLUDED.title,\\n    description = EXCLUDED.description,\\n    status = EXCLUDED.status,\\n    due_date = EXCLUDED.due_date,\\n    sync_hash = EXCLUDED.sync_hash,\\n    last_modified = EXCLUDED.last_modified,\\n    synced_at = EXCLUDED.synced_at",
        "options": {}
      },
