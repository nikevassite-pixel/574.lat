    {
      "parameters": {
        "jsCode": "// Normalize Trello cards\nconst items = $input.all();\nconst normalized = [];\n\nitems.forEach(item => {\n  const card = item.json;\n  \n  normalized.push({\n    source: 'trello',\n    external_id: card.id,\n    title: card.name,\n    description: card.desc || '',\n    due_date: card.due || null,\n    status: 'active',\n    labels: card.labels?.map(l => l.name) || [],\n    assignees: card.idMembers || [],\n    last_modified: card.dateLastActivity,\n    synced_at: new Date().toISOString()\n  });\n});\n\nreturn normalized.map(item => ({ json: item }));"
      },
      "id": "normalize-trello",
      "name": "Normalize Trello Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "jsCode": "// Normalize Asana tasks\nconst items = $input.all();\nconst normalized = [];\n\nitems.forEach(item => {\n  const task = item.json;\n  \n  normalized.push({\n    source: 'asana',\n    external_id: task.gid,\n    title: task.name,\n    description: task.notes || '',\n    due_date: task.due_on || null,\n    status: task.completed ? 'completed' : 'active',\n    labels: task.tags?.map(t => t.name) || [],\n    assignees: task.assignee ? [task.assignee.gid] : [],\n    last_modified: task.modified_at,\n    synced_at: new Date().toISOString()\n  });\n});\n\nreturn normalized.map(item => ({ json: item }));"
      },
      "id": "normalize-asana",
      "name": "Normalize Asana Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 500]
    },
    {
      "parameters": {
        "jsCode": "// Normalize Jira issues\nconst items = $input.all();\nconst normalized = [];\n\nitems.forEach(item => {\n  const issue = item.json;\n  \n  normalized.push({\n    source: 'jira',\n    external_id: issue.id,\n    title: issue.fields.summary,\n    description: issue.fields.description || '',\n    due_date: issue.fields.duedate || null,\n    status: issue.fields.status.name.toLowerCase(),\n    labels: issue.fields.labels || [],\n    assignees: issue.fields.assignee ? [issue.fields.assignee.accountId] : [],\n    last_modified: issue.fields.updated,\n    synced_at: new Date().toISOString()\n  });\n});\n\nreturn normalized.map(item => ({ json: item }));"
      },
      "id": "normalize-jira",
      "name": "Normalize Jira Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 700]
    },
