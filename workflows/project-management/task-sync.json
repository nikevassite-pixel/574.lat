    {
      "parameters": {
        "jsCode": "// Detect conflicts and determine sync actions\nconst allTasks = $input.first().json;\nconst syncState = $input.item(1).json;\n\n// Create sync state map\nconst stateMap = new Map();\nif (Array.isArray(syncState)) {\n  syncState.forEach(item => {\n    const key = `${item.source}:${item.external_id}`;\n    stateMap.set(key, item);\n  });\n}\n\n// Process tasks and detect changes\nconst syncActions = [];\nconst conflicts = [];\n\nallTasks.forEach(task => {\n  const key = `${task.source}:${task.external_id}`;\n  const currentState = stateMap.get(key);\n  \n  // Generate hash for change detection\n  const taskHash = require('crypto')\n    .createHash('md5')\n    .update(JSON.stringify({\n      title: task.title,\n      description: task.description,\n      status: task.status,\n      due_date: task.due_date\n    }))\n    .digest('hex');\n  \n  task.sync_hash = taskHash;\n  \n  if (!currentState) {\n    // New task\n    syncActions.push({\n      action: 'create',\n      task: task,\n      targets: ['trello', 'asana', 'jira'].filter(t => t !== task.source)\n    });\n  } else if (currentState.sync_hash !== taskHash) {\n    // Task has been modified\n    const lastModified = new Date(task.last_modified);\n    const stateModified = new Date(currentState.last_modified);\n    \n    if (lastModified > stateModified) {\n      // Check for conflicts\n      const conflictingTasks = allTasks.filter(t => \n        t.title === task.title && \n        t.source !== task.source &&\n        new Date(t.last_modified) > stateModified\n      );\n      \n      if (conflictingTasks.length > 0) {\n        conflicts.push({\n          title: task.title,\n          sources: [task.source, ...conflictingTasks.map(t => t.source)],\n          resolution_strategy: 'most_recent',\n          selected: task // Use most recently modified\n        });\n      }\n      \n      syncActions.push({\n        action: 'update',\n        task: task,\n        targets: ['trello', 'asana', 'jira'].filter(t => t !== task.source)\n      });\n    }\n  }\n});\n\nreturn {\n  json: {\n    sync_actions: syncActions,\n    conflicts: conflicts,\n    summary: {\n      total_tasks: allTasks.length,\n      actions_needed: syncActions.length,\n      conflicts_detected: conflicts.length\n    }\n  }\n};"
      },
      "id": "detect-conflicts",
      "name": "Detect Conflicts and Changes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 500]
    },
