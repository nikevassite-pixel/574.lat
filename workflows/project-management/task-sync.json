    {
      "parameters": {
        "jsCode": "// Format conflict notification\nconst data = $input.first().json;\nconst conflicts = data.conflicts;\n\nlet message = `⚠️ *Task Sync Conflicts Detected*\\n\\n`;\nmessage += `Found ${conflicts.length} conflict${conflicts.length > 1 ? 's' : ''} during sync:\\n\\n`;\n\nconflicts.forEach((conflict, index) => {\n  message += `*${index + 1}. ${conflict.title}*\\n`;\n  message += `Platforms: ${conflict.sources.join(', ')}\\n`;\n  message += `Resolution: Using most recent version from ${conflict.selected.source}\\n\\n`;\n});\n\nmessage += `_Sync completed at ${new Date().toLocaleString()}_`;\n\nreturn { json: { message: message, conflict_count: conflicts.length } };"
      },
      "id": "format-conflict-notification",
      "name": "Format Conflict Notification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1450, 700]
