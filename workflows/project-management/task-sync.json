    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT external_id, source, title, status, last_modified, sync_hash FROM task_sync_state",
        "options": {}
      },
      "id": "get-sync-state",
      "name": "Get Current Sync State",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [450, 500],
      "credentials": {
        "postgres": {
          "id": "7",
          "name": "PostgreSQL"
        }
      }
