{"name":"Kubernetes Cluster Health Monitor","nodes":[{"parameters":{"rule":{"interval":[{"field":"minutes","minutesInterval":5}]}},"id":"schedule","name":"Schedule - Every 5 Min","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1,"position":[250,300]},{"parameters":{"command":"kubectl get pods --all-namespaces -o json"},"id":"get-pods","name":"kubectl - Get All Pods","type":"n8n-nodes-base.executeCommand","typeVersion":1,"position":[450,300]},{"parameters":{"functionCode":"const pods = JSON.parse($input.item.json).items;\nconst unhealthy = pods.filter(p => p.status.phase !== 'Running' || p.status.conditions?.some(c => c.type === 'Ready' && c.status !== 'True'));\nreturn unhealthy.map(p => ({json: {name: p.metadata.name, namespace: p.metadata.namespace, status: p.status.phase, reason: p.status.reason}}));"},"id":"check-health","name":"Check Pod Health","type":"n8n-nodes-base.code","typeVersion":2,"position":[650,300]},{"parameters":{"resource":"channel","operation":"sendMessage","channelId":"={{ $env.SLACK_K8S_CHANNEL }}","text":"=⚠️ *K8s Alert*: {{ $json.name }} in {{ $json.namespace }} is {{ $json.status }}"},"id":"alert","name":"Slack - Send Alert","type":"n8n-nodes-base.slack","typeVersion":2.1,"position":[850,300],"credentials":{"slackApi":{"id":"10","name":"Slack API"}}}],"connections":{"Schedule - Every 5 Min":{"main":[[{"node":"kubectl - Get All Pods","type":"main","index":0}]]},"kubectl - Get All Pods":{"main":[[{"node":"Check Pod Health","type":"main","index":0}]]},"Check Pod Health":{"main":[[{"node":"Slack - Send Alert","type":"main","index":0}]]}},"settings":{"executionOrder":"v1"},"tags":[{"id":"devops","name":"DevOps & CI/CD"}],"versionId":"1.0.0"}
